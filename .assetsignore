# Files Wrangler must NOT upload as public static assets.
# wrangler.jsonc uses `assets.directory: "./"`, so everything in the repo root
# is published unless it is listed here.

# Repo internals / dependencies
.git
.gitignore
.gitattributes
node_modules
.wrangler

# Tooling and config
package.json
package-lock.json
wrangler.jsonc

# Docs and notes
CLAUDE.md
README.md

# Secrets / local env
.env
.env.*
.dev.vars
.dev.vars.*
